            android:name=".Home.pertemuan_3.EmailInputActivity"
            android:exported="false" />
        <activity
            android:name=".Home.pertemuan_3.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".BaseActivity"
            android:exported="false" />
        <activity
            android:name=".Home.pertemuan_6.WebViewActivity"
            android:exported="false" />

        <activity
            android:name=".Home.pertemuan_6.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Home.pertemuan_3.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".Home.pertemuan_4.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".Home.pertemuan_4.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".Home.pertemuan_2.RumusBangunRuangActivity"
            android:exported="false" />
