<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="32dp">

        <ImageView
            android:id="@+id/imgLogo3"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/logo_bina_desa"
            android:contentDescription="Logo Aplikasi Slide 3" />

        <TextView
            android:id="@+id/tvDeskripsiOnboarding3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/bg_light"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="Silakan Masuk Untuk Menikmati Layanan Kesehatan Desa Kami" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAyoMulai"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="160dp" android:text="AYO MULAI"
        android:backgroundTint="#4088D1"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textAllCaps="true"
        app:cornerRadius="10dp" />

</RelativeLayout>