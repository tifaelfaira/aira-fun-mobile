<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- TOOLBAR TETAP SAMA DAN INTACT -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#70B5F5"
        app:title="Tambah Kegiatan"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@android:color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- CARD VIEW OKE ELEGAN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- PERBAIKAN: Menggunakan paddingBottom agar jarak ke EditText di bawahnya konsisten rapi -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Form Kegiatan Kesehatan Desa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:paddingBottom="16dp"/>

                    <!-- ID AMAN & TEXT HINT PAS -->
                    <EditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nama Kegiatan (Contoh: Posyandu Balita)"
                        android:textColorHint="#90A4AE"
                        android:backgroundTint="#70B5F5"
                        android:textSize="15sp"
                        android:inputType="textCapWords"/>

                    <!-- PERBAIKAN: Ditambah inputType MultiLine & gravity top agar ketikan panjang otomatis turun ke bawah -->
                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Detail Kegiatan / Lokasi / Jumlah Warga"
                        android:textColorHint="#90A4AE"
                        android:backgroundTint="#70B5F5"
                        android:textSize="15sp"
                        android:minLines="3"
                        android:gravity="top"
                        android:inputType="textMultiLine"/>

                    <!-- ======================================================== -->
                    <!-- TAMBAHAN: INPUT MENIT REMINDER (SANGAT BERSIH DAN RAPI) -->
                    <!-- ======================================================== -->
                    <EditText
                        android:id="@+id/etMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Ingatkan dalam berapa menit lagi?"
                        android:textColorHint="#90A4AE"
                        android:backgroundTint="#70B5F5"
                        android:textSize="15sp"
                        android:inputType="number"/>
                    <!-- ======================================================== -->

                    <!-- ID TOMBOL AMAN & SERASI -->
                    <Button
                        android:id="@+id/btnSaveAgenda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:backgroundTint="#70B5F5"
                        android:text="Simpan Data Kesehatan"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ILUSTRASI TAMBAHAN BIAR BAGIAN BAWAH GA POLOS GERSANG -->
            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="24dp"
                android:alpha="0.6"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#70B5F5"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pastikan data yang dimasukkan sudah benar"
                android:textColor="#78909C"
                android:textSize="12sp"
                android:textStyle="italic"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>